{
  "name": "minions-assembler",
  "version": "1.0.0",
  "description": "Minions Assembler — Assemble custom GitHub Copilot agents from versioned JSON — CLI (CI) + serve (API/Swagger/UI) + SQLite audit",
  "type": "module",
  "bin": {
    "minions-assembler": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:web",
    "build:web": "npm --prefix web ci --no-audit --no-fund && npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "serve": "node dist/cli.js serve",
    "dev:serve": "tsx src/cli.ts serve",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "scripts",
    "examples"
  ],
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.0",
    "@github/copilot-sdk": "^1.0.19",
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.10.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
