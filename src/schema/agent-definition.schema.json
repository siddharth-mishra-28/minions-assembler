{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minions-assembler/schema/agent-definition-1.0.json",
  "title": "AgentDefinition v1.0",
  "description": "Single source of truth for a custom GitHub Copilot agent. Maps to Copilot SDK createSession/send options.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "task", "provider"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "color": {
          "description": "Identity color for chat UI (agent chat bubbles). Optional hex; when absent a deterministic palette color is derived from the agent id.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "persona": {
      "description": "Session system prompt. SDK has no separate persona field; this maps to systemMessage. Optional: omit systemMessage entirely to run on the SDK-managed default Copilot CLI prompt only.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "useCopilotDefaultPrompt": {
          "description": "Whether the agent keeps the SDK-managed default Copilot CLI system prompt (preamble, identity, tone, tool_instructions, safety…). Default true. append/customize keep it; replace drops it (and its guardrails).",
          "type": "boolean",
          "default": true
        },
        "systemMessage": {
          "type": "object",
          "additionalProperties": false,
          "allOf": [
            { "if": { "required": ["mode"], "properties": { "mode": { "const": "replace" } } }, "then": { "required": ["content"], "properties": { "content": {} } } },
            { "anyOf": [ { "required": ["content"], "properties": { "content": {} } }, { "required": ["sections"], "properties": { "sections": {} } } ] }
          ],
          "properties": {
            "mode": { "type": "string", "enum": ["append", "replace", "customize"], "default": "append" },
            "content": { "type": "string", "minLength": 1 },
            "acknowledgeReplaceRisks": { "type": "boolean" },
            "sections": {
              "description": "Per-section overrides for mode=customize. Keys are the SYSTEM_MESSAGE_SECTIONS ids of the installed @github/copilot-sdk (GET /api/persona/default-system-prompt lists them and shows the default prompt they belong to).",
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(preamble|identity|tone|tool_efficiency|environment_context|code_change_rules|guidelines|safety|tool_instructions|custom_instructions|runtime_instructions|last_instructions)$": {
                  "type": "object",
                  "required": ["action"],
                  "additionalProperties": false,
                  "properties": {
                    "action": { "type": "string", "enum": ["replace", "remove", "append", "prepend", "preserve"] },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "instructions": {
      "description": "Repo guidance. Explicitly injected (SDK discovery not guaranteed).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": { "type": "array", "items": { "type": "string" } },
        "scoped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["applyTo", "body"],
            "additionalProperties": false,
            "properties": {
              "applyTo": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "agentsMdPaths": { "type": "array", "items": { "type": "string" } },
        "refreshDiscoveryCache": { "type": "boolean", "default": false }
      }
    },
    "knowledge": {
      "description": "Emulated knowledge base (SDK has no knowledgeBases field).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workingDirectory": { "type": "string" },
        "additionalDirectories": { "type": "array", "items": { "type": "string" } },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["file", "directory", "blob"] },
              "path": { "type": "string" },
              "data": { "type": "string" },
              "mimeType": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        },
        "sessionStore": {
          "description": "Cross-session store: when unset, runtime defaults apply in copilot-cli mode and defaults to disabled in empty mode.",
          "type": "boolean"
        },
        "maxAttachmentBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "agents": {
      "description": "Inline customAgents (specialist sub-agents).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "prompt"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "tools": {
            "type": ["array", "null"],
            "items": { "type": "string" },
            "description": "Tool allowlist for this sub-agent. Coding-harness tools (bash, mkdir, write, create) are injected automatically unless tools.harness is false."
          },
          "mcpServers": { "type": "object" },
          "infer": { "type": "boolean" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "model": { "type": "string" },
          "reasoningEffort": { "type": "string" }
        }
      }
    },
    "defaultAgent": { "type": "string" },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } }
      }
    },
    "task": {
      "description": "User prompt / task sent via send/sendAndWait.",
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "deliveryMode": { "type": "string", "enum": ["enqueue", "immediate"], "default": "enqueue" },
        "attachments": { "type": "array" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "parametersSchema"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parametersSchema": { "type": "object" },
              "skipPermission": { "type": "boolean" }
            }
          }
        },
        "available": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "harness": {
          "description": "Inject coding-harness tools (bash, mkdir, write) and auto-create parent directories for create/write/edit. Default true.",
          "type": "boolean",
          "default": true
        },
        "permissionPolicy": { "type": "string", "enum": ["deny-all", "approve-all-ci-only", "pattern-list"], "default": "deny-all" },
        "builtins": {
          "description": "Built-in tool availability + per-tool decisions. default: posture for any tool without a perTool entry (built-in, MCP and custom); all: select-all toggle; perTool: name (bare or source-qualified builtin:/mcp:/custom:) → allow|ask|deny. 'ask' resolves as an audited deny in headless runs.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default": { "type": "string", "enum": ["allow", "ask", "deny"], "default": "allow" },
            "all": { "type": "boolean", "default": true },
            "perTool": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["allow", "ask", "deny"] }
            }
          }
        },
        "allowDestructive": {
          "description": "Allow destructive update/delete operations (rm -rf, forced pushes, DROP…), process-kill commands (taskkill/pkill/killall/kill/Stop-Process) and destructive-flagged MCP tool calls. Default false.",
          "type": "boolean",
          "default": false
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "decision"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string" },
              "decision": { "type": "string", "enum": ["allow", "deny", "ask"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["local", "stdio", "http", "sse"] },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "cwd": { "type": "string" },
              "url": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "tools": { "type": "array", "items": { "type": "string" } },
              "timeoutMs": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "disabled": { "type": "array", "items": { "type": "string" } },
        "timeoutDefaultMs": { "type": "integer", "minimum": 1 },
        "use": {
          "description": "References to servers in the MCP registry (POST /api/mcp): a name string or {name, allow, deny, disabled}.",
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "allow": { "type": "array", "items": { "type": "string" } },
                  "deny": { "type": "array", "items": { "type": "string" } },
                  "disabled": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "provider": {
      "description": "BYOK provider. `providerApiKey` is the fixed credential attribute: an `enc:v1:` token (AES-256-GCM at rest), a `${ENV_VAR}` reference, or a literal key that is sealed to a token on save. Legacy `credentialEnv` is still accepted.",
      "type": "object",
      "required": ["type", "baseUrl", "model", "providerApiKey"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["openai", "azure", "anthropic"] },
        "baseUrl": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "wireApi": { "type": "string", "enum": ["completions", "responses"] },
        "providerApiKey": { "type": "string", "minLength": 1 },
        "credentialEnv": { "type": "string", "minLength": 1 },
        "azureApiVersion": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": { "type": "boolean" },
        "sessionId": { "type": "string" },
        "resume": { "type": "boolean" },
        "idleTimeoutSecs": { "type": "integer", "minimum": 1 },
        "toolSearch": {
          "description": "Tool-search override: enabled=false preloads tools instead of deferring them behind tool_search_tool; deferThreshold sets the defer limit.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": false },
            "deferThreshold": { "type": "integer", "minimum": 1 }
          }
        },
        "excludedBuiltinAgents": {
          "description": "Names of built-in runtime agents to hide from discovery.",
          "type": "array",
          "items": { "type": "string" }
        },
        "includedBuiltinSkills": {
          "description": "Runtime-bundled skills to include; omit to use runtime defaults (built-ins are opt-in only in empty mode).",
          "type": "array",
          "items": { "type": "string" }
        },
        "turnTimeoutMs": {
          "description": "Per-turn budget for sendAndWait in ms. Resolution: API body > this field > RUN_TURN_TIMEOUT_MS env > default 2700000 (45 min).",
          "type": "integer",
          "minimum": 1000,
          "maximum": 21600000
        },
        "maxAiCredits": { "type": "number" },
        "logLevel": { "type": "string", "enum": ["error", "warning", "info", "debug"] },
        "autopilot": {
          "description": "Session autopilot mode (experimental in the SDK runtime).",
          "type": "boolean"
        },
        "autopilot": { "type": "boolean" },
        "clientInfo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "applicationName": { "type": "string" },
            "applicationVersion": { "type": "string" },
            "integrationName": { "type": "string" },
            "integrationVersion": { "type": "string" }
          }
        }
      }
    },
    "fleet": {
      "description": "Fleet mode: parallel sub-agent orchestration for concurrent agents (uses Copilot SDK session.rpc.fleet.start).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "prompt": { "type": "string" },
        "maxConcurrentWorkers": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 }
      }
    }
  }
}
