{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-assembler/schema/agent-definition-1.0.json",
  "title": "AgentDefinition v1.0",
  "description": "Single source of truth for a custom GitHub Copilot agent. Maps to Copilot SDK createSession/send options.",
  "type": "object",
  "required": ["schemaVersion", "metadata", "persona", "task", "provider"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "persona": {
      "description": "Session system prompt. SDK has no separate persona field; this maps to systemMessage.",
      "type": "object",
      "required": ["systemMessage"],
      "additionalProperties": false,
      "properties": {
        "systemMessage": {
          "type": "object",
          "required": ["content"],
          "additionalProperties": false,
          "properties": {
            "mode": { "type": "string", "enum": ["append", "replace", "customize"], "default": "append" },
            "content": { "type": "string", "minLength": 1 },
            "acknowledgeReplaceRisks": { "type": "boolean" },
            "sections": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^(identity|preamble|tone|guidelines|safety|tool_instructions)$": {
                  "type": "object",
                  "required": ["action"],
                  "additionalProperties": false,
                  "properties": {
                    "action": { "type": "string", "enum": ["replace", "remove", "append", "prepend", "preserve"] },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "instructions": {
      "description": "Repo guidance. Explicitly injected (SDK discovery not guaranteed).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "global": { "type": "array", "items": { "type": "string" } },
        "scoped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["applyTo", "body"],
            "additionalProperties": false,
            "properties": {
              "applyTo": { "type": "string" },
              "body": { "type": "string" }
            }
          }
        },
        "agentsMdPaths": { "type": "array", "items": { "type": "string" } },
        "refreshDiscoveryCache": { "type": "boolean", "default": false }
      }
    },
    "knowledge": {
      "description": "Emulated knowledge base (SDK has no knowledgeBases field).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workingDirectory": { "type": "string" },
        "additionalDirectories": { "type": "array", "items": { "type": "string" } },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "additionalProperties": false,
            "properties": {
              "type": { "type": "string", "enum": ["file", "directory", "blob"] },
              "path": { "type": "string" },
              "data": { "type": "string" },
              "mimeType": { "type": "string" },
              "displayName": { "type": "string" }
            }
          }
        },
        "sessionStore": {
          "description": "Cross-session store: when unset, runtime defaults apply in copilot-cli mode and defaults to disabled in empty mode.",
          "type": "boolean"
        },
        "maxAttachmentBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "agents": {
      "description": "Inline customAgents (specialist sub-agents).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "prompt"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string" },
          "description": { "type": "string" },
          "tools": { "type": ["array", "null"], "items": { "type": "string" } },
          "mcpServers": { "type": "object" },
          "infer": { "type": "boolean" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "model": { "type": "string" },
          "reasoningEffort": { "type": "string" }
        }
      }
    },
    "defaultAgent": { "type": "string" },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": { "type": "array", "items": { "type": "string" } },
        "disabled": { "type": "array", "items": { "type": "string" } }
      }
    },
    "task": {
      "description": "User prompt / task sent via send/sendAndWait.",
      "type": "object",
      "required": ["prompt"],
      "additionalProperties": false,
      "properties": {
        "prompt": { "type": "string", "minLength": 1 },
        "deliveryMode": { "type": "string", "enum": ["enqueue", "immediate"], "default": "enqueue" },
        "attachments": { "type": "array" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "description", "parametersSchema"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "description": { "type": "string" },
              "parametersSchema": { "type": "object" },
              "skipPermission": { "type": "boolean" }
            }
          }
        },
        "available": { "type": "array", "items": { "type": "string" } },
        "excluded": { "type": "array", "items": { "type": "string" } },
        "permissionPolicy": { "type": "string", "enum": ["deny-all", "approve-all-ci-only", "pattern-list"], "default": "deny-all" },
        "patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "decision"],
            "additionalProperties": false,
            "properties": {
              "tool": { "type": "string" },
              "decision": { "type": "string", "enum": ["allow", "deny", "ask"] },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "servers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["local", "stdio", "http", "sse"] },
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "cwd": { "type": "string" },
              "url": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "tools": { "type": "array", "items": { "type": "string" } },
              "timeoutMs": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "disabled": { "type": "array", "items": { "type": "string" } },
        "timeoutDefaultMs": { "type": "integer", "minimum": 1 },
        "use": {
          "description": "References to servers in the MCP registry (POST /api/mcp): a name string or {name, allow, deny, disabled}.",
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "allow": { "type": "array", "items": { "type": "string" } },
                  "deny": { "type": "array", "items": { "type": "string" } },
                  "disabled": { "type": "boolean" }
                }
              }
            ]
          }
        }
      }
    },
    "provider": {
      "description": "BYOK provider. Credentials resolved from env at runtime, never stored.",
      "type": "object",
      "required": ["type", "baseUrl", "model", "credentialEnv"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["openai", "azure", "anthropic"] },
        "baseUrl": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "wireApi": { "type": "string", "enum": ["completions", "responses"] },
        "credentialEnv": { "type": "string", "minLength": 1 },
        "azureApiVersion": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "streaming": { "type": "boolean" },
        "sessionId": { "type": "string" },
        "resume": { "type": "boolean" },
        "idleTimeoutSecs": { "type": "integer", "minimum": 1 },
        "maxAiCredits": { "type": "number" },
        "logLevel": { "type": "string", "enum": ["error", "warning", "info", "debug"] },
        "autopilot": { "type": "boolean" },
        "clientInfo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "applicationName": { "type": "string" },
            "applicationVersion": { "type": "string" },
            "integrationName": { "type": "string" },
            "integrationVersion": { "type": "string" }
          }
        }
      }
    }
  }
}
