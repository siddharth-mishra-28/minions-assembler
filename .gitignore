run_*/
.chats/
workflow_*/
workspace/
workspace-*/

# CI and verification output: generated apps, reports, dependency caches
app/
reports/
tools/
.npm/
.npm-global/
.m2/
.tmp/

# acceptance evidence, backups and smoke output
evidence/
backup/
.smoke/

# packaged artifacts and archives
*.tgz
*.tar.gz
*.zip

# logs, coverage and editor/OS noise
*.log
npm-debug.log*
coverage/
.DS_Store
Thumbs.db
