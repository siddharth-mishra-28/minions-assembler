{
  "schemaVersion": "1.0",
  "metadata": { "name": "mimo-smoke-test", "version": "1.0.0", "description": "Minimal agent for Mimo provider E2E", "tags": ["smoke", "mimo"] },
  "persona": { "systemMessage": { "mode": "append", "content": "You are a concise senior engineer. Answer briefly with evidence. Never reveal credentials." } },
  "instructions": { "global": ["Prefer minimal diffs.", "Cite file paths when referencing code."], "refreshDiscoveryCache": false },
  "knowledge": { "workingDirectory": ".", "sessionStore": false },
  "agents": [
    { "name": "researcher", "displayName": "Research Agent", "description": "Explores code and answers questions", "prompt": "You are a research assistant. Analyze code; do not modify files.", "tools": ["grep", "glob", "view"], "infer": true }
  ],
  "defaultAgent": "researcher",
  "skills": { "directories": ["./skills"], "disabled": [] },
  "task": { "prompt": "Reply with exactly: MIMO-OK and one sentence describing what you are.", "deliveryMode": "enqueue" },
  "tools": { "permissionPolicy": "deny-all", "patterns": [] },
  "mcp": { "servers": {}, "disabled": [] },
  "provider": { "type": "openai", "baseUrl": "https://token-plan-sgp.xiaomimimo.com/v1", "model": "mimo-v2.6-flash", "wireApi": "completions", "credentialEnv": "LLM_API_KEY" },
  "runtime": { "streaming": true, "idleTimeoutSecs": 300, "maxAiCredits": 100, "logLevel": "info", "clientInfo": { "applicationName": "minion-assembler", "applicationVersion": "1.0.0", "integrationName": "e2e", "integrationVersion": "1.0.0" } }
}
