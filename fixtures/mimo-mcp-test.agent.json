{
  "schemaVersion": "1.0",
  "metadata": { "name": "mimo-mcp-test", "version": "1.0.0", "description": "Agent that uses an MCP server from the registry", "tags": ["mcp", "smoke"] },
  "persona": { "systemMessage": { "mode": "append", "content": "You are a concise senior engineer. When asked to echo, use the echo tool if available; otherwise just reply plainly." } },
  "instructions": { "global": ["Keep answers short."] },
  "agents": [],
  "task": { "prompt": "Reply with exactly: MCP-USE-OK", "deliveryMode": "enqueue" },
  "tools": { "permissionPolicy": "pattern-list", "patterns": [{ "tool": "*", "decision": "allow", "reason": "smoke test" }] },
  "mcp": { "use": ["inventory-echo"] },
  "provider": { "type": "openai", "baseUrl": "https://token-plan-sgp.xiaomimimo.com/v1", "model": "mimo-v2.6-flash", "wireApi": "completions", "credentialEnv": "LLM_API_KEY" },
  "runtime": { "streaming": true, "idleTimeoutSecs": 300, "maxAiCredits": 100, "logLevel": "info" }
}
